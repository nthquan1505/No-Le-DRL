# ==============================================================
# Facebook RSS Bot - Environment Configuration
# ==============================================================

# --------------------------------------------------------------
# Residential Proxy (CRITICAL for 24/7 server / GitHub Actions)
# --------------------------------------------------------------
# Format:
#   http://username:password@host:port
#   socks5://username:password@host:port
#
# Examples with popular residential proxy providers:
#   FB_PROXY_URL=http://user123:pass456@geo.iproyal.com:12321
#   FB_PROXY_URL=http://customer-xyz:pwd@pr.brightdata.com:22225
#   FB_PROXY_URL=http://user:pass@pr.oxylabs.io:7777
#   FB_PROXY_URL=socks5://user:pass@127.0.0.1:1080
FB_PROXY_URL=

# --------------------------------------------------------------
# Custom Fine-Tuned Model (Free Google Colab Tunnel or Local Ollama)
# --------------------------------------------------------------
# If set, the extractor calls this OpenAI-compatible endpoint FIRST,
# and automatically falls back to GEMINI_API_KEY if offline:
#   Colab Tunnel example : https://xxxx.trycloudflare.com/v1/chat/completions
#   Local Ollama example : http://127.0.0.1:11434/v1/chat/completions
CUSTOM_LLM_URL=
CUSTOM_LLM_MODEL=event-extractor

# --------------------------------------------------------------
# Gemini API Keys (Fallback / Standard Extraction LLM)
# --------------------------------------------------------------
# Single key or comma-separated pool:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TUNED_MODEL=

# --------------------------------------------------------------
# Admin Dashboard Security
# --------------------------------------------------------------
ADMIN_TOKEN=imkmentbihngnhigh

# --------------------------------------------------------------
# DRL Database Configuration (PostgreSQL or SQLite fallback)
# --------------------------------------------------------------
# Leave empty to use local SQLite (`drl_database.db`), or set a PostgreSQL URL:
#   DRL_DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/nole_drl
DRL_DATABASE_URL=

# --------------------------------------------------------------
# Ngrok Live Demo Tunnel (Optional)
# --------------------------------------------------------------
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
